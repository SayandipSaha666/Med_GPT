  "components": [
    {
      "name": "Primary New Chat Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main conversation creation action in the rail.",
      "html": "<button class=\"ds-primary\">New Chat</button>",
      "css": ".ds-primary{background:#176b63;color:#fff;border:0;border-radius:9px;padding:11px 16px;font:650 14px ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-primary:hover{background:#0d554e}.ds-primary:focus-visible{outline:2px solid var(--med-focus,#258f83);outline-offset:2px}"
    },
    {
      "name": "Quiet Action",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Secondary action used around the conversation.",
      "html": "<button class=\"ds-quiet\">New conversation</button>",
      "css": ".ds-quiet{background:transparent;color:var(--med-accent,#176b63);border:0;border-radius:8px;padding:8px 10px;font:650 12px ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-quiet:hover{background:var(--med-accent-soft,#e5f3ef)}.ds-quiet:focus-visible{outline:2px solid var(--med-focus,#258f83);outline-offset:2px}"
    },
    {
      "name": "Composer",
      "kind": "input",
      "refersTo": "composer",
      "description": "The fixed question composer beneath the reading column.",
      "html": "<div class=\"ds-composer\"><label for=\"ds-question\">Your message</label><textarea id=\"ds-question\" placeholder=\"Ask a health question…\"></textarea><button type=\"button\">Send</button></div>",
      "css": ".ds-composer{background:var(--med-surface,#fff);color:var(--med-ink,#172826);border:1px solid #b8cdc2;border-radius:17px;padding:16px 17px 12px;box-shadow:0 8px 27px -20px #29463b70;display:flex;flex-direction:column;gap:10px}.ds-composer:focus-within{border-color:var(--med-focus,#258f83);box-shadow:0 0 0 3px color-mix(in srgb,var(--med-focus,#258f83) 13%,transparent)}.ds-composer label{font:650 11px ui-sans-serif,system-ui,sans-serif}.ds-composer textarea{border:0;outline:0;resize:vertical;min-height:45px;background:transparent;color:inherit;font:15px/1.6 ui-sans-serif,system-ui,sans-serif}.ds-composer button{align-self:end;background:var(--med-accent,#176b63);color:var(--med-surface,#fff);border:0;border-radius:10px;padding:8px 12px;cursor:pointer}.ds-composer button:hover{background:var(--med-accent-hover,#0d554e)}.ds-composer button:focus-visible{outline:2px solid var(--med-focus,#258f83);outline-offset:2px}"
    },
    {
      "name": "Conversation Row",
      "kind": "nav",
      "description": "A quiet chat destination with a selected wash.",
      "html": "<nav class=\"ds-nav\"><a href=\"#conversation\" class=\"ds-row\">Understanding a blood test</a></nav>",
      "css": ".ds-nav{background:var(--med-rail,#f1f4f1);padding:8px}.ds-row{display:block;color:var(--med-ink,#172826);text-decoration:none;border-radius:8px;padding:11px 12px;font:560 13px ui-sans-serif,system-ui,sans-serif}.ds-row:hover{background:var(--med-surface,#fff)}.ds-row:focus-visible{outline:2px solid var(--med-focus,#258f83);outline-offset:2px}.ds-row[aria-current=page]{background:var(--med-accent-soft,#e5f3ef)}"
    },
    {
      "name": "Source Row",
      "kind": "card",
      "refersTo": "source-row",
      "description": "Numbered supporting source attached to an answer.",
      "html": "<a class=\"ds-source\" href=\"#source\"><span class=\"ds-index\">1</span><span><strong>Complete blood count overview</strong><small>Medical source</small></span></a>",
      "css": ".ds-source{display:flex;align-items:flex-start;gap:10px;padding:11px 12px;background:var(--med-surface,#fff);border:1px solid var(--med-border,#dce5df);border-radius:9px;color:var(--med-ink,#172826);text-decoration:none;font:12px ui-sans-serif,system-ui,sans-serif}.ds-source:hover{border-color:var(--med-accent,#176b63);background:var(--med-accent-soft,#e5f3ef)}.ds-source:focus-visible{outline:2px solid var(--med-focus,#258f83);outline-offset:2px}.ds-index{display:grid;place-items:center;width:22px;height:22px;border-radius:6px;background:var(--med-accent-soft,#e5f3ef);color:var(--med-accent,#176b63);font-weight:700}.ds-source strong,.ds-source small{display:block}.ds-source small{margin-top:3px;color:var(--med-muted,#53635f)}"
    },
    {
      "name": "User Message",
      "kind": "card",
      "description": "A user question on a distinct pale surface.",
      "html": "<article class=\"ds-user\">What can a high neutrophil count mean?</article>",
      "css": ".ds-user{background:var(--med-user,#edf4f0);color:var(--med-ink,#172826);border-radius:11px;padding:15px 18px 9px;font:15px/1.72 ui-sans-serif,system-ui,sans-serif}"
    },
    {
      "name": "Theme Switch",
      "kind": "button",
      "description": "Light and dark appearance control in the conversation rail.",
      "html": "<button class=\"ds-switch\" type=\"button\" role=\"switch\" aria-checked=\"true\" aria-label=\"Dark mode\"><span></span></button>",
      "css": ".ds-switch{width:44px;height:24px;border:0;border-radius:999px;background:var(--med-accent,#176b63);padding:2px;cursor:pointer}.ds-switch span{display:block;width:20px;height:20px;border-radius:50%;background:var(--med-surface,#fff);margin-left:auto}.ds-switch:hover{background:var(--med-accent-hover,#0d554e)}.ds-switch:focus-visible{outline:2px solid var(--med-focus,#258f83);outline-offset:2px;box-shadow:0 0 0 2px var(--med-focus,#258f83)}"
    }
  ],
  "narrative": {
    "northStar": "The Calm Research Desk",
    "overview": "The conversation workspace gives health information room to be read. A pale mineral canvas, restrained teal controls, and a centered document column make the answer and its supporting material the focus. The MedGPT name and existing logo anchor the navigation rail. Dark mode keeps the same hierarchy with charcoal surfaces and lighter teal.\n\nThe interface is spacious at the page level and compact inside controls. Questions, answers, attached files, and actual sources remain visibly distinct. The composer stays available below the reading area, with the medical safety sentence beneath it.",
    "keyCharacteristics": [
      "A quiet rail beside a single reading column.",
      "Teal for actions, links, citations, and selected states.",
      "Fine rules and soft surface changes for separation.",
      "Matching light and dark semantic roles."
    ],
    "rules": [
      {
        "name": "The Semantic Pair Rule",
        "body": "A new workspace surface must use the same role in both themes; do not keep a light surface color in dark mode.",
        "section": "colors"
      },
      {
        "name": "The Reading Measure Rule",
        "body": "Keep answer prose within (70ch) even when the outer reading column is wider.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use borders and tonal layers for reading surfaces; reserve soft elevation for the composer and the floating menu control.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the reading column centered and the composer aligned beneath it.",
      "Do use the semantic color pair for every new light and dark workspace element.",
      "Do show source rows only from actual source data, with citation numbers linked to those rows.",
      "Do retain a visible focus outline and the safety sentence below the composer."
    ],
    "donts": [
      "Don't turn the assistant's reading text into a filled message card; the current answer rests on the canvas.",
      "Don't add broad elevation to the rail, source list, or answer body; their separation is tonal and ruled.",
      "Don't make a decorative color or a source claim compete with the health information."
    ]
  }
}
