# Docker Compose reads this root-level file for ${VARIABLE} substitutions.
# Replace every CHANGE_ME value before starting the stack.

# Public URLs/origins used by the browser and frontend build.
VITE_SERVER_URL=http://localhost:3000
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL container
POSTGRES_USER=medgpt
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_URL_SAFE_PASSWORD
POSTGRES_DB=MedGPT_DB

# Internal RabbitMQ task queue (use a URL-safe password)
RABBITMQ_DEFAULT_USER=medgpt
RABBITMQ_DEFAULT_PASS=CHANGE_ME_USE_A_URL_SAFE_PASSWORD

# Internal service authentication and encryption.
# Generate ENCRYPTION_MASTER_KEY as 64 hexadecimal characters (32 random bytes).
AGENT_SERVICE_API_KEY=CHANGE_ME
ENCRYPTION_MASTER_KEY=CHANGE_ME_64_HEX_CHARACTERS
JWT_SECRET_KEY=CHANGE_ME
REFRESH_TOKEN_SECRET=CHANGE_ME

# External provider credentials
GROQ_AGENT_API_KEY=CHANGE_ME
GROQ_OCR_API_KEY=CHANGE_ME
GROQ_API_KEY=CHANGE_ME
PINECONE_API_KEY=CHANGE_ME
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# Optional deployment settings
MODEL_PROVIDER=groq
OCR_PROVIDER=groq
MAX_FILE_SIZE_MB=10
RUN_SEED=false
