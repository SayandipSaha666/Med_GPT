# User service (copy to .env and replace placeholders)
USER_SERVICE_PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
JWT_SECRET_KEY=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
RAG_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_URL=http://localhost:4000
AGENT_SERVICE_API_KEY=replace-with-the-same-secret-as-agent-service
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173

RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
MAX_FILE_SIZE_MB=10

# Document OCR
OCR_PROVIDER=groq
GEMINI_OCR_API_KEY=replace-me
GEMINI_OCR_MODEL=gemini-3.5-flash-lite
GROQ_OCR_API_KEY=replace-me
GROQ_OCR_MODEL=qwen/qwen3.8-27b
OPENAI_OCR_API_KEY=replace-me
OPENAI_OCR_MODEL=gpt-4o-2024-11-20

# Must match the agent service key for shared encrypted data
ENCRYPTION_MASTER_KEY=replace-with-a-shared-key-at-least-32-characters
