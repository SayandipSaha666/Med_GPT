# Agent backend service (copy to .env and replace placeholders)
AGENT_SERVICE_PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
AGENT_SERVICE_API_KEY=replace-with-the-same-secret-as-user-service
AGENT_ALLOWED_ORIGINS=http://localhost:5173
RAG_SERVICE_URL=http://localhost:8000

MODEL_PROVIDER=groq
GROQ_AGENT_API_KEY=replace-me
GROQ_AGENT_MODEL=openai/gpt-oss-120b
OPENAI_AGENT_API_KEY=replace-me
OPENAI_AGENT_MODEL=gpt-4o-mini
GUARDRAILS_ENABLED=true
OPENAI_API_KEY=replace-me

# Must match the user service key for shared encrypted data
ENCRYPTION_MASTER_KEY=replace-with-a-shared-key-at-least-32-characters
SERPAPI_KEY=replace-me
GOOGLE_SEARCH_API_KEY=replace-me
GOOGLE_SEARCH_CX=replace-me
