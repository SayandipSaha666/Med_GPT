# Copy to .env and fill in values. See .env.example for details.
PORT=4001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:password@localhost:5432/medgpt?schema=public"
RAG_SERVICE_URL=http://localhost:8000
MODEL_PROVIDER=openai
OPENAI_AGENT_API_KEY=sk-proj-your_openai_agent_api_key
OPENAI_AGENT_MODEL=gpt-4o
GUARDRAILS_ENABLED=true
ENCRYPTION_MASTER_KEY=your_32_character_or_longer_encryption_key_here
SERPAPI_KEY=your_serpapi_key
