# RAG / Vector Search Services
PINECONE_API_KEY=***
GROQ_API_KEY=***
HUGGINGFACEHUB_API_TOKEN=***
BACKEND_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# AI/LLM Provider Configuration
# ============================================================================

# MODEL_PROVIDER: Selects which provider to use for AGENTS (OpenAI SDK)
# - "openai": Uses OpenAI API for agents/guardrails (requires OPENAI_AGENT_API_KEY)
# - "groq": Uses GroqCloud API for agents/guardrails via OpenAI-compatible endpoint (requires GROQ_AGENT_API_KEY)
AGENT_SERVICE_PORT=4000
AGENT_SERVICE_URL=http://localhost:4000
AGENT_SERVICE_API_KEY=***
AGENT_ALLOWED_ORIGINS=http://localhost:5173
MODEL_PROVIDER="groq"

# Agent System - OpenAI SDK Provider
# When MODEL_PROVIDER=openai: Uses OpenAI API with OPENAI_AGENT_MODEL
# When MODEL_PROVIDER=groq: Uses GroqCloud API with GROQ_AGENT_MODEL
GROQ_AGENT_API_KEY=***
GROQ_AGENT_MODEL=openai/gpt-oss-120b

OPENAI_AGENT_API_KEY="SK_**"
OPENAI_AGENT_MODEL="gpt-4o-mini"
GUARDRAILS_ENABLED=true

# ============================================================================
# OCR / Text Extraction Configuration
# ============================================================================

# OCR_PROVIDER: Selects which provider to use for OCR
# - "gemini": Uses Google Gemini Vision API (requires GEMINI_OCR_API_KEY)
# - "groq": Uses GroqCloud API with Qwen for OCR (requires GROQ_OCR_API_KEY)
# - "openai": Uses OpenAI GPT-4o Vision (requires OPENAI_OCR_API_KEY)
OCR_PROVIDER=groq

# Gemini OCR - Google Gemini Vision API
GEMINI_OCR_API_KEY=AQ.***
GEMINI_OCR_MODEL=gemini-3.5-flash-lite

# Groq OCR - GroqCloud API (OpenAI-compatible) with Qwen
GROQ_OCR_API_KEY=***
GROQ_OCR_MODEL=qwen/qwen3.8-27b

# OpenAI OCR - OpenAI GPT-4o Vision
OPENAI_OCR_API_KEY="sk_***"
OPENAI_OCR_MODEL=gpt-4o-2024-11-20

# Legacy provider keys used by current extraction and agent services
OPENAI_API_KEY="sk_***"
GEMINI_API_KEY="AQ.***"

# ============================================================================
# Optional Services
# ============================================================================

ENCRYPTION_MASTER_KEY=***
SERPAPI_KEY=***
GOOGLE_SEARCH_API_KEY=AIzaSyCAygH-***
GOOGLE_SEARCH_CX=***
