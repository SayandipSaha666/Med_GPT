# ============================================================================
# MedGPT - Environment Configuration Example
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# NODE BACKEND SERVICE
# ============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/medgpt?schema=public"

# JWT Authentication
JWT_SECRET_KEY="your_secret_hex_string_for_access_tokens_minimum_32_characters"
REFRESH_TOKEN_SECRET="your_secret_hex_string_for_refresh_tokens_minimum_32_characters"

# RAG Service URL
RAG_SERVICE_URL=http://localhost:8000

# Frontend CORS - comma-separated list of allowed origins
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ============================================================================
# Razorpay Payment Gateway
# ============================================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ============================================================================
# Cloudinary File Storage
# ============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================================================
# File Upload Configuration
# ============================================================================
MAX_FILE_SIZE_MB=10

# ============================================================================
# Backend CORS - comma-separated list of allowed origins
# ============================================================================
BACKEND_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# RAG / Vector Search Services
# ============================================================================
PINECONE_API_KEY=pcsk_your_pinecone_api_key
GROQ_API_KEY=gsk_your_groq_api_key
HUGGINGFACEHUB_API_TOKEN=hf_your_huggingface_token

# ============================================================================
# AI/LLM Provider Configuration
# ============================================================================

# MODEL_PROVIDER: Selects which provider to use for AGENTS (OpenAI SDK)
# - "openai": Uses OpenAI API for agents/guardrails (requires OPENAI_AGENT_API_KEY)
# - "groq": Uses GroqCloud API for agents/guardrails via OpenAI-compatible endpoint (requires GROQ_AGENT_API_KEY)
MODEL_PROVIDER=openai

# Agent System - OpenAI SDK Provider
# When MODEL_PROVIDER=openai: Uses OpenAI API with OPENAI_AGENT_MODEL
# When MODEL_PROVIDER=groq: Uses GroqCloud API with GROQ_AGENT_MODEL
# OPENAI_AGENT_API_KEY=sk-proj-your_openai_agent_api_key
# GROQ_AGENT_API_KEY=gsk_your_groq_agent_api_key
# OPENAI_AGENT_MODEL=gpt-4o
# GROQ_AGENT_MODEL=qwen/qwen-2-7b

GUARDRAILS_ENABLED=true

# ============================================================================
# OCR / Text Extraction Configuration
# ============================================================================

# OCR_PROVIDER: Selects which provider to use for OCR
# - "gemini": Uses Google Gemini Vision API (requires GEMINI_OCR_API_KEY)
# - "groq": Uses GroqCloud API with Qwen for OCR (requires GROQ_OCR_API_KEY)
# - "openai": Uses OpenAI GPT-4o Vision (requires OPENAI_OCR_API_KEY)
OCR_PROVIDER=gemini

# Gemini OCR - Google Gemini Vision API
GEMINI_OCR_API_KEY=AIzaSy_your_gemini_ocr_api_key
GEMINI_OCR_MODEL=gemini-2.0-flash-exp

# Groq OCR - GroqCloud API (OpenAI-compatible) with Qwen
# GROQ_OCR_API_KEY=gsk_your_groq_ocr_api_key
# GROQ_OCR_MODEL=qwen/qwen-2.5-32b

# OpenAI OCR - OpenAI GPT-4o Vision
# OPENAI_OCR_API_KEY=sk-proj-your_openai_ocr_api_key
# OPENAI_OCR_MODEL=gpt-4o-2024-11-20

# ============================================================================
# Optional Services
# ============================================================================

ENCRYPTION_MASTER_KEY=your_32_character_or_longer_encryption_key_here
SERPAPI_KEY=your_serpapi_key
GOOGLE_SEARCH_API_KEY=your_google_search_api_key
GOOGLE_SEARCH_CX=your_custom_search_engine_id

# ============================================================================
# Supported File Types
# ============================================================================
# Documents: .txt, .pdf, .doc, .docx
# Images: .png, .jpg, .jpeg, .gif, .webp  <- WebP is fully supported
# ============================================================================
# OCR Support:
# - PDF (scanned and digital)
# - Images (PNG, JPEG, GIF, WEBP)
# - DOCX
# - Plain text files
# ============================================================================
